FROM node:22-alpine AS build
WORKDIR /app
ARG ADMIN_PASSWORD
ARG OFFICER_PASSWORD
ARG COORDINATOR_PASSWORD
ARG RECRUITER_PASSWORD
ARG STUDENT_PASSWORD
ENV VITE_ADMIN_PASSWORD=$ADMIN_PASSWORD \
    VITE_OFFICER_PASSWORD=$OFFICER_PASSWORD \
    VITE_COORDINATOR_PASSWORD=$COORDINATOR_PASSWORD \
    VITE_RECRUITER_PASSWORD=$RECRUITER_PASSWORD \
    VITE_STUDENT_PASSWORD=$STUDENT_PASSWORD
COPY package.json package-lock.json* ./
RUN npm install
COPY . .
RUN npm run build

FROM nginx:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
